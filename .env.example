# Exemple uniquement — ne jamais mettre les vraies clés dans GitHub
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxxxxxxxxxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Génération IA côté serveur
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5-mini

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key

# PayPal subscriptions
PAYPAL_ENV=sandbox
PAYPAL_PLAN_ID=your_paypal_plan_id
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Klaviyo server-side
KLAVIYO_PRIVATE_API_KEY=server_only_private_key

# Alexya image/video generation - server only
ALEXYA_API_KEY=aph_live_xxxxxxxxxxxxxxxxx

# Protected scheduler / cron
CRON_SECRET=replace_with_long_random_secret
